{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cargo",
      "command": "test",
      "args": ["--all-features"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "label": "cargo test --all-features"
    },
    {
      "type": "cargo",
      "command": "clippy",
      "args": ["--all-targets", "--all-features"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "cargo clippy"
    },
    {
      "type": "cargo",
      "command": "bench",
      "args": [],
      "problemMatcher": ["$rustc"],
      "label": "cargo bench"
    }
  ]
}

